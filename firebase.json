{
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "tests/**", "docs/**", "package.json", "README.md", "firestore.rules", "firestore.indexes.json"],
    "headers": [
      { "source": "**/*.@(js|css|html|json)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.@(png|svg|webp|jpg|woff2)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/admin/**", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
    ]
  }
}
